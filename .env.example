# DGX B200 Multi-Node Training Configuration Example
# Copy this file to .env and customize for your environment

# =============================================================================
# NETWORK CONFIGURATION - CHANGE THESE FOR YOUR ENVIRONMENT
# =============================================================================

# Master node InfiniBand IP address (CHANGE THIS)
MASTER_ADDR=YOUR_MASTER_NODE_IB_IP

# Communication port for distributed training
MASTER_PORT=29500

# =============================================================================
# NODE CONFIGURATION 
# =============================================================================

# Total number of nodes in your cluster
NUM_NODES=2

# Current node rank (0 for master, 1,2,3... for workers)
# Override this on each node
NODE_RANK=0

# GPUs per node (DGX B200 has 8 H100 GPUs)
NUM_GPUS_PER_NODE=8

# =============================================================================
# DGX B200 SPECIFIC SETTINGS (Usually don't need to change)
# =============================================================================

# DGX B200 InfiniBand interface names (proven configuration)
NCCL_SOCKET_IFNAME="ibp24s0,ibp64s0,ibp79s0,ibp94s0,ibp154s0,ibp192s0,ibp206s0,ibp220s0"

# DGX B200 InfiniBand HCA adapters
NCCL_IB_HCA="mlx5_4,mlx5_7,mlx5_8,mlx5_9,mlx5_10,mlx5_13,mlx5_14,mlx5_15"

# NCCL network optimization settings
NCCL_NET_GDR_LEVEL=PIX
NCCL_IB_DISABLE=0
NCCL_DEBUG=INFO

# =============================================================================
# TRAINING CONFIGURATION
# =============================================================================

# Training configuration file
TRAINING_CONFIG=configs/training_config.json

# DeepSpeed configuration file  
DEEPSPEED_CONFIG=configs/deepspeed_4node_dgx.json

# Hostfile for multi-node training
HOSTFILE=configs/hostfile.txt

# Output directory for training results
OUTPUT_DIR=./outputs