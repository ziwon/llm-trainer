{
  "_comment": "Optimized for DGX B200 (80GB+ VRAM) - High performance settings",
  "model_name": "Qwen/Qwen3-1.7B",
  "dataset_name": "tatsu-lab/alpaca",
  "max_length": 2048,
  "gradient_checkpointing": false,
  
  "num_epochs": 3,
  "batch_size_per_device": 16,
  "learning_rate": 2e-4,
  "gradient_accumulation_steps": 1,
  "warmup_steps": 100,
  
  "use_lora": true,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.1,
  
  "mixed_precision": "bf16",
  "use_flash_attention_2": true,
  "torch_compile": true,
  "use_custom_training_loop": true,
  
  "output_dir": "./outputs",
  "save_steps": 500,
  "logging_steps": 10,
  "save_total_limit": 3,
  
  "optim": "adamw_torch_fused",
  "adam_beta1": 0.9,
  "adam_beta2": 0.95,
  "adam_epsilon": 1e-8,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "warmup_ratio": 0.03,
  "lr_scheduler_type": "cosine",
  
  "dataloader_num_workers": 8,
  "dataloader_pin_memory": true,
  "dataloader_prefetch_factor": 4,
  "dataloader_persistent_workers": true,
  
  "gpu_utilization_monitoring": true,
  "monitor_interval_steps": 50,
  
  "use_wandb": false,
  "wandb_project": "llm-finetuning-dgx-b200",
  "report_to": []
}