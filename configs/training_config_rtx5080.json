{
  "_comment": "Ultra-conservative for RTX 5080 (16GB VRAM) - Maximum memory efficiency",
  "model_name": "Qwen/Qwen3-1.7B",
  "dataset_name": "tatsu-lab/alpaca",
  "max_length": 256,
  "gradient_checkpointing": true,
  
  "num_epochs": 3,
  "batch_size_per_device": 1,
  "learning_rate": 2e-4,
  "gradient_accumulation_steps": 8,
  "warmup_steps": 100,
  
  "use_lora": true,
  "lora_r": 4,
  "lora_alpha": 8,
  "lora_dropout": 0.1,
  
  "mixed_precision": "fp16",
  "use_flash_attention_2": false,
  "torch_compile": false,
  "use_custom_training_loop": true,
  
  "output_dir": "./outputs",
  "save_steps": 500,
  "logging_steps": 25,
  "save_total_limit": 2,
  
  "optim": "adamw_torch",
  "adam_beta1": 0.9,
  "adam_beta2": 0.95,
  "adam_epsilon": 1e-8,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "warmup_ratio": 0.03,
  "lr_scheduler_type": "cosine",
  
  "dataloader_num_workers": 0,
  "dataloader_pin_memory": true,
  "dataloader_prefetch_factor": 2,
  "dataloader_persistent_workers": false,
  
  "gpu_utilization_monitoring": true,
  "monitor_interval_steps": 25,
  
  "use_wandb": false,
  "wandb_project": "llm-finetuning-rtx5080",
  "report_to": []
}